<section class="home-projects" aria-labelledby="home-projects-heading">
  <h2 id="home-projects-heading">Projects</h2>
  <ul class="home-projects-list" tabindex="0" aria-label="Projects — scroll left or right to explore">
    {% for project in site.data.home_projects %}
      <li>
        <a class="home-project-link" href="{{ project.url }}" target="_blank" rel="noopener noreferrer">
          <span class="home-project-thumbnail">
            <img src="{{ project.image | relative_url }}" alt="{{ project.alt | escape }}" loading="lazy" width="640" height="280">
          </span>
          <span class="home-project-details">
            <span class="home-project-title">{{ project.title }}</span>
            <span class="home-project-destination">
              {{- project.link_label }}
              <span aria-hidden="true">↗</span></span
            >
          </span>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
